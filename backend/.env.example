# Django
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# Database (MySQL 8.0+)
DB_ENGINE=django.db.backends.mysql
DB_NAME=university_exchange
DB_USER=root
DB_PASSWORD=123456
DB_HOST=127.0.0.1
DB_PORT=3306

# 从库配置：不填 DB_REPLICA_HOST 时读请求回退到主库
DB_REPLICA_HOST=
DB_REPLICA_PORT=
DB_REPLICA_NAME=
DB_REPLICA_USER=
DB_REPLICA_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://your-domain.com

# Redis
# 使用 Docker 基础设施时，docker-compose.yml 将两个 Redis 实例分别映射到：
#   redis-ws     -> 宿主机 6379
#   redis-cache  -> 宿主机 6380
# 若使用本地单个 Redis 实例，全部改为 127.0.0.1:6379 并选用不同 db。
REDIS_URL=redis://127.0.0.1:6379/1
REDIS_WS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6380/1

# RabbitMQ (Celery broker 可选)
RABBITMQ_URL=amqp://campus:campus@127.0.0.1:5672//

# Celery
CELERY_BROKER_URL=amqp://campus:campus@127.0.0.1:5672//
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/3

# Static & Media
MEDIA_URL=/media/
STATIC_URL=/static/

# Elasticsearch (可选)
ELASTICSEARCH_HOSTS=http://127.0.0.1:9200
ELASTICSEARCH_TIMEOUT=10
ELASTICSEARCH_FALLBACK_TO_DB=True
ELASTICSEARCH_INDEX_PREFIX=campus
